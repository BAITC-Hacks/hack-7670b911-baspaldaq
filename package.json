{
  "name": "baspaldaq",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "prisma:deploy": "npm run prisma:deploy --workspace server",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:validate": "npm run prisma:validate --workspace server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
