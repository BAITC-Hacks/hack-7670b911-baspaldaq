{
  "name": "@baspaldaq/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "prisma:migrate": "node --env-file=../.env node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node --env-file=../.env node_modules/prisma/build/index.js migrate deploy",
    "prisma:generate": "node --env-file=../.env node_modules/prisma/build/index.js generate",
    "prisma:validate": "node --env-file=../.env node_modules/prisma/build/index.js validate",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.73",
    "@prisma/client": "6.12.0",
    "ai": "^7.0.112",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  }
}
