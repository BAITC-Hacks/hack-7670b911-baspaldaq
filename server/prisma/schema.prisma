generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id          String                   @id @default(cuid())
  description String
  score       Int                      @default(0)
  level       String                   @default("draft")
  status      String                   @default("CLARIFYING")
  topic       String?
  confirmedAt DateTime?
  publishedAt DateTime?
  fields      TaskField[]
  dimensions  TaskDimension[]
  questions   ClarificationQuestion[]
  answers     ClarificationAnswer[]
  messages    TaskMessage[]
  proposals   Proposal[]
  milestones  Milestone[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model Team {
  id           String      @id @default(cuid())
  name         String
  interests    String      @default("")
  skills       String      @default("")
  technologies String      @default("")
  points       Int         @default(0)
  proposals    Proposal[]
  milestones   Milestone[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Proposal {
  id           String   @id @default(cuid())
  taskId       String
  teamId       String
  solutionIdea String
  plan         String
  timeline     String
  prototypeUrl String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([teamId])
}

model Milestone {
  id          String    @id @default(cuid())
  taskId      String
  teamId      String
  title       String
  confirmedAt DateTime?
  points      Int       @default(0)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([taskId])
  @@index([teamId])
}

model TaskField {
  id         String   @id @default(cuid())
  taskId     String
  key        String
  value      String?
  status     String   @default("pending")
  provenance String   @default("initial_description")
  sourceId   String?
  evidence   String?
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([taskId, key])
  @@index([taskId, status])
}

model TaskDimension {
  id       String @id @default(cuid())
  taskId   String
  key      String
  aiStatus String @default("missing")
  evidence String @default("[]")
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, key])
}

model ClarificationQuestion {
  id                String              @id @default(cuid())
  taskId            String
  question          String
  targetDimensions  String
  reason            String
  status            String              @default("open")
  task              Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  answer            ClarificationAnswer?
  messages          TaskMessage[]
  retryCount        Int                 @default(0)
  createdAt         DateTime            @default(now())
  answeredAt        DateTime?

  @@index([taskId, status])
}

model ClarificationAnswer {
  id         String                @id @default(cuid())
  taskId     String
  questionId String                @unique
  answer     String
  task       Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  question   ClarificationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime              @default(now())

  @@index([taskId])
}

model TaskMessage {
  id         String                 @id @default(cuid())
  taskId     String
  questionId String?
  role       String
  kind       String
  content    String
  task       Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  question   ClarificationQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  createdAt  DateTime               @default(now())

  @@index([taskId, createdAt])
  @@index([questionId])
}
